        <mxCell id="qdrant" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e0e7ff;strokeColor=#4f46e5;" value="Qdrant&#xa;向量 + payload user_id" vertex="1">
          <mxGeometry height="100" width="190" x="1240" y="270" as="geometry" />
