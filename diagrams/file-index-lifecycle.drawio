        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;" value="用户文件操作&#xa;上传 / 秒传 / 覆盖 / 删除" vertex="1">
