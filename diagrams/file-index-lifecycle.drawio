        <mxCell id="agent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontStyle=1;" value="Agent&#xa;解析 / embedding / BM25&#xa;reindex 或 unindex" vertex="1">
