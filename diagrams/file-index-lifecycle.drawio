        </mxCell>
        <mxCell id="storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontStyle=1;" value="MySQL + MinIO&#xa;元数据 / 对象内容" vertex="1">
          <mxGeometry height="100" width="220" x="620" y="150" as="geometry" />
        </mxCell>
        <mxCell id="queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;" value="Redis&#xa;task:index_notify&#xa;重试 / 退避" vertex="1">
