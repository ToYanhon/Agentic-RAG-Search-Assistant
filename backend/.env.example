# 本地开发配置示例：复制为 .env 后按需修改。
# 优先级：真实环境变量 > .env 文件 > 代码默认值。
# 真实环境变量（含 docker-compose environment 注入）不会被本文件覆盖。

# HTTP 服务
CD_SERVER_PORT=8080

# MySQL（DSN，字段分隔符需用 & 连接）
CD_MYSQL_DSN=root:root@tcp(localhost:3306)/cloud_drive?parseTime=true&loc=Asia%2FShanghai

# Redis
CD_REDIS_ADDR=localhost:6379
CD_REDIS_PASSWORD=

# 认证
CD_JWT_SECRET=change-me-in-production
CD_JWT_EXPIRE_HOURS=72

# MinIO（本地开发用 localhost:9100；容器内由 compose 注入服务名）
CD_MINIO_ENDPOINT=localhost:9100
CD_MINIO_ACCESS_KEY=minioadmin
CD_MINIO_SECRET_KEY=minioadmin
CD_MINIO_BUCKET=cloud-drive

# 上传限制（字节）
CD_UPLOAD_DIRECT_MAX_BYTES=52428800
CD_UPLOAD_CHUNK_MAX_BYTES=10485760
CD_UPLOAD_FILE_MAX_BYTES=10737418240

# Agent 代理
CD_AGENT_BASE_URL=http://127.0.0.1:8000
CD_AGENT_RESPONSE_HEADER_TIMEOUT_SEC=60
CD_AGENT_MAX_CONCURRENT=20

# LLM 配置加密主密钥（prod 必须 ≥32 字节并妥善保管，勿提交仓库）
CD_LLM_ENCRYPTION_KEY=dev-only-llm-encryption-key-change-me-32b
