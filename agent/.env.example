# 本地开发配置示例：复制为 .env 后填入真实值
# docker-compose 环境变量优先于本文件（容器内以 compose environment 为准）

# LLM
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 成本估算单价（元/百万 tokens）
LLM_PRICE_INPUT=1.0
LLM_PRICE_OUTPUT=2.0
# 后端地址（本地 localhost；容器内 http://backend:8080/api/v1）
BACKEND_URL=http://localhost:8080/api/v1

# MinIO（本地开发用 localhost:9000；容器内由 compose 注入服务名）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cloud-drive

# Redis
REDIS_URL=redis://localhost:6379/0
